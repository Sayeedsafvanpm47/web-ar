# Copy to .env.local for development. Never commit .env.local.
#
# NEXT_PUBLIC_* is embedded in the browser bundle. Anything not prefixed
# NEXT_PUBLIC_ stays server-side. Read that twice before adding a var.

# --- Supabase: safe to expose -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase: SERVER ONLY ----------------------------------------------
# Bypasses Row Level Security completely. If this reaches the browser,
# every customer video in the system is readable by anyone.
# Hard rule 4: never NEXT_PUBLIC_, never imported by a client component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Cloudflare R2: SERVER ONLY -----------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=black-pearl-media
# Seconds a signed video URL stays valid. Keep short.
R2_SIGNED_URL_TTL_SECONDS=300

# --- Sentry -------------------------------------------------------------
# The DSN is a write-only ingestion endpoint, not a secret. NEXT_PUBLIC_ is
# correct for it. Find it at: Project Settings > Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=

# BUILD-TIME ONLY, server-side. Uploads source maps during `next build`; it is
# never read at runtime and must never be NEXT_PUBLIC_. Create at
# Settings > Auth Tokens. Scopes: project:releases, project:read, org:read.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug
